{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/main.ts",
    "scripts/**/*.mjs",
    "scripts/**/*.test.mjs"
  ],
  "ignoreDependencies": [
    "tailwindcss",
    "@tauri-apps/cli"
  ],
  "ignoreExports": [
    {
      "file": "src/lib/gitGraphLayout.ts",
      "exports": ["GRAPH_ROW_HEIGHT", "GRAPH_LANE_WIDTH"]
    }
  ],
  "health": {
    "ignore": [
      "**/*.{test,spec}.{ts,tsx,js,jsx,mjs,cjs}"
    ]
  }
}
