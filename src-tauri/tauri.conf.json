{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OTerm",
  "version": "0.3.9",
  "identifier": "com.Oerum.oterm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "oterm",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "backgroundColor": "#0a0a0a",
        "devtools": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "infoPlist": "./Info.plist",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJENEFENDc5NURFN0JFMUMKUldRY3Z1ZGRlZFJLdld0S05JMnF5K2IyMTFsNXB1UEZDZXREbndzbXFOaFp2RkZnQjJ1WUpPdXIK",
      "endpoints": [
        "https://github.com/Oerum/OTerm/releases/latest/download/latest.json"
      ]
    }
  }
}
